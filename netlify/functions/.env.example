# These are SERVER-ONLY secrets. Set them in Netlify Dashboard -> Site settings
# -> Environment variables. Never commit real values or put them in a VITE_ var.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key    # Supabase -> Settings -> API -> service_role
JWT_SECRET=a-long-random-string-you-make-up

# The one Super Admin account. They log in at /admin/login and, from there,
# create every Teacher account (each teacher gets their own username/password
# stored — hashed — in the database, assigned to specific classes & subjects).
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=choose-a-strong-password
