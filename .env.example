# Frontend (safe to expose in the browser — used only to complete signed file uploads)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Private admin login path. Do not link this on public pages.
VITE_ADMIN_LOGIN_PATH=/school-admin-console-7f3c/login


# E2E-only student session override. Configure ONLY on Netlify/server environment, never in VITE_* variables.
# Use a dedicated test student account, not a real student account.
E2E_TEST_SECRET=replace-with-a-long-random-secret
E2E_TEST_STUDENT_CLASS=IX
E2E_TEST_STUDENT_ROLL=999

# Separate dedicated account for testing the normal single-session lock (no E2E bypass).
LOCK_TEST_STUDENT_CLASS=IX
LOCK_TEST_STUDENT_ROLL=998
LOCK_TEST_STUDENT_DOB=2013-06-01
